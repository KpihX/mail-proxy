# ── mail-proxy configuration ─────────────────────────────────────────────────
# Location : ~/.config/mail-proxy/.env      (chmod 600 — contains secrets)
# Created  : mail-proxy admin setup
# Every line below is documented with a real, valid example value.
#
# Accounts are declared in src/mail_proxy/config.py (hosts, ports, e-mail,
# display name, signature). This file only carries the per-account SECRETS
# plus optional overrides. Account env prefix: MAIL_<ACCOUNT_ID_UPPER>_.
# The default account of this repository is `poly` → MAIL_POLY_*.

# [REQUIRED] IMAP/SMTP login of the `poly` account.
# Where  : Polytechnique webmail (webmail.polytechnique.fr), same credentials
#          for IMAP and SMTP.
# Example: MAIL_POLY_LOGIN=ivann.kamdem-pouokam
MAIL_POLY_LOGIN=

# [REQUIRED] IMAP/SMTP password of the `poly` account.
# Never committed. Written by `mail-proxy admin setup` (HITL form) or exported
# manually — process environment always wins over this file.
# Example: MAIL_POLY_PASS=correct-horse-battery-staple
MAIL_POLY_PASS=

# [OPTIONAL] Override the account e-mail address used in the From header and
# the SMTP envelope. Falls back to the account definition in config.py.
# Example: MAIL_POLY_EMAIL=ivann.kamdem-pouokam@polytechnique.edu
MAIL_POLY_EMAIL=

# [OPTIONAL] Override the display name shown in the From header.
# Example: MAIL_POLY_DISPLAY_NAME=Ivann KAMDEM POUOKAM
MAIL_POLY_DISPLAY_NAME=

# [OPTIONAL] Override the IMAP endpoint of the `poly` account.
# Example: MAIL_POLY_IMAP_HOST=webmail.polytechnique.fr
MAIL_POLY_IMAP_HOST=
# Example: MAIL_POLY_IMAP_PORT=993
MAIL_POLY_IMAP_PORT=
# Example: MAIL_POLY_IMAP_TLS=true
MAIL_POLY_IMAP_TLS=

# [OPTIONAL] Override the SMTP endpoint of the `poly` account.
# Example: MAIL_POLY_SMTP_HOST=webmail.polytechnique.fr
MAIL_POLY_SMTP_HOST=
# Example: MAIL_POLY_SMTP_PORT=587
MAIL_POLY_SMTP_PORT=
# Example: MAIL_POLY_SMTP_STARTTLS=true
MAIL_POLY_SMTP_STARTTLS=

# [OPTIONAL] Connection timeout in seconds for every IMAP/SMTP call.
# Example: MAIL_TIMEOUT=15
MAIL_TIMEOUT=

# Logging: NO file, NO level env var — exactly like `tg-proxy` / `tick-proxy`.
# All logs go to stderr (systemd/journald captures them). Level is fixed in
# code: setup_logging(level="WARNING").
